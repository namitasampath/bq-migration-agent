    {
      "name": "collection_rate_by_branch",
      "original_sql": "SELECT\n    b.branch_code,\n    b.branch_name,\n    COUNT(p.payment_id)                                                        AS payment_attempts,\n    COALESCE(SUM(p.amount) FILTER (WHERE p.status = 'SUCCESS'), 0)::numeric(18,4) AS collected_amount,\n    COALESCE(SUM(p.amount), 0)::numeric(18,4)                                  AS demanded_amount,\n    ROUND(\n        COALESCE(SUM(p.amount) FILTER (WHERE p.status = 'SUCCESS'), 0)\n        / NULLIF(SUM(p.amount), 0) * 100,\n        2\n    )                                                                          AS collection_rate_pct,\n    COUNT(*) FILTER (WHERE p.payment_mode ILIKE 'upi')                         AS upi_payments\nFROM branches b\nLEFT JOIN loans    l ON l.branch_id = b.branch_id\nLEFT JOIN payments p ON p.loan_id   = l.loan_id\nGROUP BY b.branch_code, b.branch_name\nORDER BY collection_rate_pct DESC NULLS LAST, b.branch_code",
      "translated_sql": "SELECT b.branch_code, b.branch_name, COUNT(p.payment_id) AS payment_attempts, CAST(COALESCE(SUM(CASE WHEN p.status = 'SUCCESS' THEN p.amount END), 0) AS NUMERIC) AS collected_amount, CAST(COALESCE(SUM(p.amount), 0) AS NUMERIC) AS demanded_amount, ROUND(COALESCE(SUM(CASE WHEN p.status = 'SUCCESS' THEN p.amount END), 0) / NULLIF(SUM(p.amount), 0) * 100, 2) AS collection_rate_pct, COUNT(CASE WHEN LOWER(p.payment_mode) LIKE 'upi' THEN 1 END) AS upi_payments FROM `your-gcp-project.migrated_lending.naive_branches` b LEFT JOIN `your-gcp-project.migrated_lending.naive_loans` l ON l.branch_id = b.branch_id LEFT JOIN `your-gcp-project.migrated_lending.naive_payments` p ON p.loan_id = l.loan_id GROUP BY b.branch_code, b.branch_name ORDER BY collection_rate_pct DESC NULLS LAST, b.branch_code",
